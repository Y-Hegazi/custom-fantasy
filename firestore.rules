rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ─────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'yousefhegazi74@gmail.com'
      ];
    }

    // ─── USERS ─────────────────────────────────────────────────────────────────
    // Each user can read/write only their own document.
    // Admins can read all users (for leaderboards & moderation).
    match /users/{uid} {
      allow read: if isSignedIn();           // leaderboard needs to read all users
      allow create: if isOwner(uid);         // only you can create your own profile
      allow update: if isOwner(uid)          // you can update your own profile
                    || isAdmin();            // admins can rename / adjust scores
      allow delete: if isAdmin();            // only admin can delete a user doc
    }

    // ─── GAMEWEEKS (Predictions) ────────────────────────────────────────────────
    // Predictions sub-collection: only owner writes their own prediction.
    // All signed-in users can read any prediction (needed for leaderboard).
    match /gameweeks/{gwId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();             // finalized flag is set by admin only

      match /predictions/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(uid);  // only you write your own picks
        allow delete: if isAdmin();
      }
    }

    // ─── MATCHES CACHE ──────────────────────────────────────────────────────────
    // Publicly readable — users need to see fixture data.
    // Only admins / the live-update function write to this.
    // EXCEPTION: tryTriggerLiveUpdate runs client-side, so signed-in users
    // need write access here too (the transaction lock prevents race conditions).
    match /matches_cache/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();          // client-side crowd-sourced updater
    }

    // ─── LEAGUES ────────────────────────────────────────────────────────────────
    // Any signed-in user can read leagues (for join flows).
    // Only the league admin can update/delete their league.
    // Any signed-in user can create a league.
    // Any signed-in member can update the members array (for joining).
    match /leagues/{leagueId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
                        // League admin can update everything
                        resource.data.adminId == request.auth.uid
                        // Any user can add themselves as a member (join flow)
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                            && request.resource.data.members.hasAll(resource.data.members))
                    ) || isAdmin();
      allow delete: if resource.data.adminId == request.auth.uid || isAdmin();
    }

    // ─── SYSTEM (Read-only for users) ───────────────────────────────────────────
    // Announcement, status, standings, score_overrides — users only read.
    match /system/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── BACKUPS (Admin only) ────────────────────────────────────────────────────
    match /backups/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── DENY EVERYTHING ELSE ────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
